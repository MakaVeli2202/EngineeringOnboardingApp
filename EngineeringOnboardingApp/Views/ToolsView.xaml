<UserControl x:Class="EngineeringOnboardingApp.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="820"
             Background="Transparent">
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tools &amp; Software" Style="{StaticResource H1TextStyle}"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Detect Installed" Style="{StaticResource EngButtonStyle}"
                        Command="{Binding DetectAllCommand}" Margin="0,0,10,0"/>
                <Button Content="Install Selected" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding InstallSelectedCommand}" Margin="0,0,10,0"/>
                <Button Content="Install All" Style="{StaticResource EngButtonStyle}"
                        Command="{Binding InstallAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,16,0,0">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryCombo" Margin="4" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"/>
                <TextBox Grid.Column="1" Margin="4" x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search tools by name, description, or category"/>
            </Grid>
        </Border>

        <!-- Tools list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
            <ItemsControl x:Name="ToolsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#ECEEF4" FontSize="14"/>
                                        <Border Background="#33A855F7" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Required, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="REQUIRED" FontSize="9" FontWeight="Bold" Foreground="#A855F7"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#7C8AA5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#5A6374" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Padding="10,5" Background="#16181F"
                                            BorderBrush="#262B36" BorderThickness="1" Margin="0,0,8,0">
                                        <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Pending"/>
                                                    <Setter Property="Foreground" Value="#7C8AA5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Text" Value="Installed"/>
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Text" Value="Installing..."/>
                                                            <Setter Property="Foreground" Value="#A855F7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Text" Value="Failed"/>
                                                            <Setter Property="Foreground" Value="#F45B69"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status -->
        <Border Grid.Row="3" Padding="0" Margin="0,12,0,0">
            <TextBlock x:Name="StatusBar" Foreground="#9AA2B1" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
