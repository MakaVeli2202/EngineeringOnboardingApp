<UserControl x:Class="EngineeringOnboardingApp.Views.AdminLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="820"
             Background="Transparent">
    <Grid Margin="26,20">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource CardStyle}" Width="420">
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14"
                        Background="#241B3A" BorderBrush="#33A855F7" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconAdmin}"
                          Stroke="#A855F7" StrokeThickness="1.6" Width="26" Height="26" Stretch="Uniform"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Administration" Style="{StaticResource H1TextStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="Enter the admin passcode to unlock content management."
                           Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,8,0"/>

                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="PASSCODE" Style="{StaticResource SectionLabelTextStyle}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasscodeBox"
                                     KeyDown="PasscodeBox_KeyDown"
                                     Height="38"
                                     Visibility="Visible"/>
                        <TextBox x:Name="ShowBox"
                                 Height="38"
                                 Visibility="Collapsed"
                                 KeyDown="PasscodeBox_KeyDown"/>
                        <Button Grid.Column="1" x:Name="ShowToggle" Content="Show"
                                Style="{StaticResource EngButtonStyle}" Margin="8,0,0,0"
                                MinHeight="38" Click="ShowToggle_Click"/>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#F45B69" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

                <Button x:Name="UnlockBtn" Content="Unlock" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch" Margin="0,18,0,0" Click="Unlock_Click"/>

                <TextBlock x:Name="HintText" Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>