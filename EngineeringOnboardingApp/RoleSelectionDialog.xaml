<Window x:Class="EngineeringOnboardingApp.RoleSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Your Role"
        Width="460" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="#12141A" CornerRadius="14" BorderBrush="#262B36" BorderThickness="1"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Welcome" FontSize="22" FontWeight="Bold" Foreground="#ECEEF4"/>
                <TextBlock Text="What type of employee are you?"
                           FontSize="14" Foreground="#A9B4C8" Margin="0,8,0,0" TextWrapping="Wrap"
                           LineHeight="20"/>
                <TextBlock Text="This helps us show only the steps that apply to you. You can change it later in Settings."
                           FontSize="12" Foreground="#7C8AA5" Margin="0,8,0,0" TextWrapping="Wrap"
                           LineHeight="18"/>
            </StackPanel>

            <!-- Role boxes -->
            <StackPanel Grid.Row="1" Margin="0,22,0,0" VerticalAlignment="Top">
                <Button x:Name="ContractorBox" Click="ContractorBox_Click" Background="Transparent"
                        BorderBrush="#262B36" BorderThickness="1" Padding="16,14" HorizontalContentAlignment="Stretch"
                        Style="{x:Null}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ContractorRadio" Width="18" Height="18" Stroke="#5A6374" StrokeThickness="2"
                                 VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="ContractorTitle" Text="Contractor" FontSize="15" FontWeight="SemiBold" Foreground="#ECEEF4"/>
                            <TextBlock Text="Works on a contract basis. May need an E5 license for VPN access."
                                       FontSize="12" Foreground="#7C8AA5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="EmployeeBox" Click="EmployeeBox_Click" Background="Transparent"
                        BorderBrush="#262B36" BorderThickness="1" Padding="16,14" HorizontalContentAlignment="Stretch"
                        Style="{x:Null}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="EmployeeRadio" Width="18" Height="18" Stroke="#5A6374" StrokeThickness="2"
                                 VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="EmployeeTitle" Text="Direct Employee" FontSize="15" FontWeight="SemiBold" Foreground="#ECEEF4"/>
                            <TextBlock Text="Permanent employee. Contractor-only steps (like the E5 license request) are hidden."
                                       FontSize="12" Foreground="#7C8AA5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <Button x:Name="ConfirmBtn" Content="Continue" FontSize="14" FontWeight="SemiBold"
                        Foreground="#0E1A12" Background="#22C55E" BorderThickness="0"
                        Height="44" HorizontalAlignment="Stretch" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
