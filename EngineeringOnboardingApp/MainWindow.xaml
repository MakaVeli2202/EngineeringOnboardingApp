<Window x:Class="EngineeringOnboardingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Engineering Onboarding"
        Width="1680"
        Height="980"
        MinWidth="1280"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            BorderBrush="#33A855F7"
            BorderThickness="1"
            ClipToBounds="True">

        <Border.Background>
            <SolidColorBrush Color="{StaticResource BackgroundColor}"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== TITLE BAR ==================== -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="Transparent"
                    CornerRadius="14,14,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#262B36"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="8"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBolt}"
                              Stroke="#C084FC"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Engineering" Foreground="#ECEEF4" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text=" Onboarding" Foreground="#7C8AA5" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="GE HealthCare · Ultrasound Systems"
                               Foreground="#5A6374"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <Button Grid.Column="2"
                            Content="&#x2014;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            FontSize="15"
                            ToolTip="Minimize"
                            Click="Minimize_Click"/>

                    <Button Grid.Column="3"
                            Content="&#x25A1;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            FontSize="12"
                            ToolTip="Maximize / Restore"
                            Click="Maximize_Click"/>

                    <Button Grid.Column="4"
                            Content="&#x2715;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Foreground="#F45B69"
                            ToolTip="Close"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ==================== SIDEBAR ==================== -->
            <Border Grid.Row="1" Grid.Column="0" Background="#101216" CornerRadius="0,0,0,14"
                    BorderThickness="0,0,1,0" BorderBrush="#262B36">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <Border Grid.Row="0" Height="110" Background="Transparent"
                            CornerRadius="0,0,14,14" BorderThickness="0,0,0,1" BorderBrush="#262B36">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="46" Height="46" CornerRadius="12"
                                    Background="#241B3A" BorderBrush="#33A855F7" BorderThickness="1"
                                    Margin="0,0,0,8">
                                <Path Data="{StaticResource IconShield}"
                                      Stroke="#A855F7" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="24" Height="24" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ENGINEERING" FontSize="14" FontWeight="Bold" Foreground="#ECEEF4" HorizontalAlignment="Center"/>
                            <TextBlock Text="O N B O A R D I N G" FontSize="7.5" FontWeight="SemiBold" Foreground="#5A6374" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="10,10,10,0">
                        <StackPanel>

                            <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabelTextStyle}" Margin="12,6,0,6"/>

                            <Button x:Name="BtnHome" Style="{StaticResource NavButtonStyle}" Tag="active"
                                    ToolTip="Home - Onboarding dashboard" Click="BtnHome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconHomePath" Data="{StaticResource IconHome}" Stroke="#A855F7" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextHome" Text="Home" Foreground="#A855F7" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnOnboarding" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Onboarding - Guided setup checklist" Click="BtnOnboarding_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconOnboardingPath" Data="{StaticResource IconSteps}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextOnboarding" Text="Onboarding" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnTools" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Tools &amp; Software - Install software" Click="BtnTools_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconToolsPath" Data="{StaticResource IconTools}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextTools" Text="Tools &amp; Software" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnAccess" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Access &amp; Requests - Permissions &amp; approvals" Click="BtnAccess_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconAccessPath" Data="{StaticResource IconAccess}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextAccess" Text="Access &amp; Requests" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnResources" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Resources - Bookmarks &amp; learning" Click="BtnResources_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconResourcesPath" Data="{StaticResource IconResources}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextResources" Text="Resources" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionLabelTextStyle}" Margin="12,18,0,6"/>

                            <Button x:Name="BtnValidation" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Validation - Preflight checks" Click="BtnValidation_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconValidationPath" Data="{StaticResource IconValidation}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextValidation" Text="Validation" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnLogs" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Logs - Session activity" Click="BtnLogs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconLogsPath" Data="{StaticResource IconLogs}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextLogs" Text="Logs" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabelTextStyle}" Margin="12,18,0,6"/>

                            <Button x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Settings - Application settings" Click="BtnSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconSettingsPath" Data="{StaticResource IconSettings}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextSettings" Text="Settings" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnAdmin" Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Administration - Manage links &amp; settings" Click="BtnAdmin_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconAdminPath" Data="{StaticResource IconAdmin}" Stroke="#8A91A3" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TextAdmin" Text="Administration" Foreground="#8A91A3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar footer -->
                    <Border Grid.Row="2" BorderBrush="#262B36" BorderThickness="0,1,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Running with administrator rights"
                                       FontSize="10" Foreground="#22C55E" FontWeight="SemiBold"/>
                            <TextBlock Text="v1.0.0 · GEHC Ultrasound Systems"
                                       FontSize="10" Foreground="#5A6374" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== MAIN AREA ==================== -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="Transparent" Padding="26,0"
                        BorderThickness="0,0,0,1" BorderBrush="#1E232E">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="#A855F7" Margin="0,0,12,0"/>
                            <TextBlock x:Name="PageTitle" Text="Home" FontSize="20" FontWeight="Bold" Foreground="#ECEEF4" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="#22C55E" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Welcome" FontSize="11" Foreground="#7C8AA5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Border Grid.Row="1" Background="Transparent">
                    <ContentControl x:Name="MainContent"/>
                </Border>

                <!-- Footer (collapsed) -->
                <Border Grid.Row="2" Background="Transparent" Visibility="Collapsed">
                    <DockPanel Margin="15,0">
                        <TextBlock Text="Ready" Foreground="#5A6374" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
